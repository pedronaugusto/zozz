ozz-key-arrays-of-none: name no member of an animation's empty key array

Animation::Allocate gives a channel of no keys an empty span, whose data is
null, and Extern<Float3Key> and Extern<QuaternionKey> took the address of
the first key's values to save or load the whole array: a member access
through a null pointer whenever an animation has no keys in a channel. ozz's
own builder makes such an animation from a raw animation of no tracks, and
its archives load the same way.

Each Save and Load of a key array returns before naming a member when it
holds none.

Evidence: zozz's src/integration_test.zig builds an animation of no tracks
from a raw archive, saves and loads it; under UndefinedBehaviorSanitizer
upstream stops in Extern<Float3Key>::Save with "member access within null
pointer" (measured, 2026-10-31).

diff --git a/libs/ozz/src/animation/runtime/animation.cc b/libs/ozz/src/animation/runtime/animation.cc
index 55adfed..95c88b7 100644
--- a/libs/ozz/src/animation/runtime/animation.cc
+++ b/libs/ozz/src/animation/runtime/animation.cc
@@ -229,12 +229,14 @@ template <>
 struct Extern<animation::internal::Float3Key> {
   static void Save(OArchive& _archive,
                    const animation::internal::Float3Key* _keys, size_t _count) {
+    if (_count == 0) return;  // An empty span holds null: name no member.
     _archive << ozz::io::MakeArray(_keys->values,
                                    OZZ_ARRAY_SIZE(_keys->values) * _count);
   }
   static void Load(IArchive& _archive, animation::internal::Float3Key* _keys,
                    size_t _count, uint32_t _version) {
     (void)_version;
+    if (_count == 0) return;  // An empty span holds null: name no member.
     _archive >> ozz::io::MakeArray(_keys->values,
                                    OZZ_ARRAY_SIZE(_keys->values) * _count);
   }
@@ -245,6 +247,7 @@ struct Extern<animation::internal::QuaternionKey> {
   static void Save(OArchive& _archive,
                    const animation::internal::QuaternionKey* _keys,
                    size_t _count) {
+    if (_count == 0) return;  // An empty span holds null: name no member.
     _archive << ozz::io::MakeArray(_keys->values,
                                    OZZ_ARRAY_SIZE(_keys->values) * _count);
   }
@@ -252,6 +255,7 @@ struct Extern<animation::internal::QuaternionKey> {
                    animation::internal::QuaternionKey* _keys, size_t _count,
                    uint32_t _version) {
     (void)_version;
+    if (_count == 0) return;  // An empty span holds null: name no member.
     _archive >> ozz::io::MakeArray(_keys->values,
                                    OZZ_ARRAY_SIZE(_keys->values) * _count);
   }
