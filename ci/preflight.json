{
  "sources": ["src"],
  "test_roots": ["src/zozz.zig"],
  "test_dependencies": ["zozz_h", "mathref_h", "test_options", "shakedown"],
  "fuzz": {
    "parsers": [
      "initFromMemory", "initFromFile",
      "loadSkeleton", "loadAnimation",
      "loadFloatTrack", "loadFloat2Track", "loadFloat3Track", "loadFloat4Track", "loadQuaternionTrack",
      "loadRawSkeleton", "loadRawAnimation",
      "loadRawFloatTrack", "loadRawFloat2Track", "loadRawFloat3Track", "loadRawFloat4Track", "loadRawQuaternionTrack",
      "decodeGV4", "decodeGV4Stream"
    ]
  },
  "shipped": {
    "ffi": "the C boundary: the library compiles its translation units, and the installed headers are ffi/*.h",
    "libs": "the vendored ozz-animation, which the library compiles"
  },
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": ["zozz"]
    },
    "zig build measurements": {
      "command": ["zig", "build", "measurements"]
    },
    "zig build archive-versions": {
      "command": ["zig", "build", "archive-versions"]
    }
  },
  "extra_checks": [
    ["zig", "build", "check-consumer"],
    ["zig", "build", "check-coverage"],
    ["zig", "build", "check-alignment"],
    ["zig", "build", "check-comments"],
    ["zig", "build", "check-ignored"],
    ["zig", "build", "check-mathref"],
    ["zig", "build", "check-numbers"],
    ["zig", "build", "check-vendor"]
  ],
  "glint_paths": ["src", "examples", "ci", "build.zig"]
,
  "glint": {
    "rules": [
      {"id": "P003", "level": "gate"},
      {"id": "Z026", "level": "gate"},
